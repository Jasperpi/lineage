{
  "name": "lineage",
  "private": true,
  "version": "0.1.0",
  "description": "An open framework for DNA and genealogy analysis: raw-kit parsing, GEDCOM, segment matching, relationship prediction, traits, admixture, haplogroups, and grounded AI narration.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "web": "npm run dev --workspace=apps/web",
    "lineage": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
